{
  "name": "project-workspace-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "Client",
    "Server"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently -k -p \"[{name}]\" -n \"Client,Server\" -c \"cyan,green\" \"npm run dev --workspace=Client\" \"npm run dev --workspace=Server\"",
    "dev:orchestrate": "npm run dev --silent",
    "build:all": "npm run build --workspace=Client && npm run build --workspace=Server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}